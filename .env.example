# Your project runs query jobs; bigquery-public-data hosts the source tables.
GOOGLE_CLOUD_PROJECT=

# Location of the public GA4 sample dataset.
BIGQUERY_LOCATION=US

# Execution-time processing ceiling: 1 GiB per query.
BIGQUERY_MAX_BYTES_BILLED=1073741824

# Prefer Application Default Credentials for local development.
# If using a credential file, keep it outside this repository.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/credentials.json

# Server-only AI chat configuration. Use an OpenRouter model ID you have access to.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
